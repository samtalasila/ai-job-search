# Dependencies
node_modules
bun.lock

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Secrets. A source skill may need an API token for a fetching service; the
# .env holding it must never be committed.
.env
.env.*

# The real firm roster is personal - never commit it. Ship only roster.example.csv.
roster.csv

# Trigger scout state (seen signals). Depth-independent: the skill resolves
# trigger_scraper/ relative to its own directory, so state lands at
# .claude/skills/trigger-scout/trigger_scraper/seen_triggers.json and a
# repo-rooted rule silently fails to match it.
**/trigger_scraper/seen_triggers.json

# Staged lead rows awaiting register approval (personal output, register-ready).
trigger_staging_*.csv
trigger_tracker.csv

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Machine-local Claude Code user configuration and ad-hoc permission approvals.
.claude/settings.local.json

# Agent skills: track the source, ignore only deps and logs.
.agents/**/node_modules
.agents/**/*.log
.agents/usage/
